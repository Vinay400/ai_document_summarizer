# ---------------------------------------------------------------------------
# Front-end environment template. Copy to `.env`:
#     cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_ to browser code.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend. Must match the CORS allow-list on the
# backend (CORS_ORIGINS in the root .env).
VITE_API_BASE_URL=http://localhost:8000
