# ---------------------------------------------------------------------------
# AI Document Summarization - environment template
#
# Copy to `.env` at the project root and adjust as needed:
#     cp .env.example .env          (Git Bash / macOS / Linux)
#     copy .env.example .env        (Windows cmd)
#
# `.env` is gitignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# ---- Application ----
APP_NAME=AI Document Summarization API
APP_VERSION=0.1.0
DEBUG=true

# ---- Backend server ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- CORS (comma-separated list of allowed front-end origins) ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Uploads ----
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=.pdf,.docx,.txt
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

# ---- OCR (Phase 3) ----
# Set TESSERACT_CMD only if the tesseract binary is not on PATH, e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGE=eng
OCR_DPI=200
OCR_MIN_CHARS_PER_PAGE=80
# TESSERACT_CMD=

# ---- Chunking (Phase 4) ----
# Chunks are measured in characters and split on sentence boundaries.
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# ---- Cleaning (Phase 4) ----
# Strip running headers/footers: a short line repeating this many times is
# treated as boilerplate and removed. Raise HEADER_MIN_REPEATS to be more
# conservative; lower it only if your documents repeat a header on few pages.
CLEAN_STRIP_HEADERS=true
HEADER_MIN_REPEATS=3
HEADER_MAX_CHARS=120

# ---- Models (Phases 5-7) ----
# Extractive: sentence embedding model. all-MiniLM-L6-v2 is ~90 MB and fast.
EXTRACTIVE_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Abstractive: any seq2seq summarization checkpoint.
#   facebook/bart-large-cnn      ~1.6 GB, best quality, 1024-token input limit
#   sshleifer/distilbart-cnn-12-6 ~1.2 GB, ~2x faster - good for live demos
ABSTRACTIVE_MODEL=facebook/bart-large-cnn
# cpu | cuda
ABSTRACTIVE_DEVICE=cpu
